# Master Office — production settings for infra/docker-compose.prod.yml (copy to .env.production).

# Where people open the site. Plain HTTP on the machine's address:
#   PUBLIC_HOST=:80   PUBLIC_URL=http://192.168.1.10   PUBLIC_WS_URL=ws://192.168.1.10
# A domain pointing at this machine (Caddy obtains HTTPS certificates by itself):
#   PUBLIC_HOST=office.example.com   PUBLIC_URL=https://office.example.com   PUBLIC_WS_URL=wss://office.example.com
PUBLIC_HOST=:80
PUBLIC_URL=http://localhost
PUBLIC_WS_URL=ws://localhost
HTTP_PORT=80
HTTPS_PORT=443

# Secrets — generate each with:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=workos
S3_SECRET_KEY=change-me
COLLAB_SECRET=change-me
# Encrypts stored credentials (SMTP password, AI keys). Changing it later makes those unreadable: keep it safe.
SETTINGS_KEY=change-me

# Optional
# SMTP_URL=smtp://user:password@smtp.example.com:587   (outgoing mail: invitations, notifications)
# MAIL_FROM=Master Office <no-reply@example.com>
# MAIL_INBOUND_PORT=2525  MAIL_INBOUND_SECRET=…         (mail arriving from outside, §70)
# MEETING_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# OLLAMA_URL=http://ollama:11434                        (with --profile ai; or a GPU machine on the network)
