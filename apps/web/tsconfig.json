{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@workos/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@workos/doc-model/*": [
        "../../packages/doc-model/src/*"
      ],
      "@workos/doc-model": [
        "../../packages/doc-model/src/index.ts"
      ],
      "@workos/sheet-model": [
        "../../packages/sheet-model/src/index.ts"
      ],
      "@workos/slide-model": [
        "../../packages/slide-model/src/index.ts"
      ],
      "@workos/form-model": [
        "../../packages/form-model/src/index.ts"
      ],
      "@workos/base-model": [
        "../../packages/base-model/src/index.ts"
      ],
      "@workos/flow-model": [
        "../../packages/flow-model/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
